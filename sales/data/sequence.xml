<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Sales -->
        <record id="seq_havanoposdesk_sale" model="ir.sequence">
            <field name="name">Sale Sequence</field>
            <field name="code">havanoposdesk.sale</field>
            <field name="prefix">SAL/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for Quotations -->
        <record id="seq_havanoposdesk_quotation" model="ir.sequence">
            <field name="name">Quotation Sequence</field>
            <field name="code">havanoposdesk.quotation</field>
            <field name="prefix">Q/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for Credit Notes -->
        <record id="seq_havanoposdesk_sale_return" model="ir.sequence">
            <field name="name">Credit Note Sequence</field>
            <field name="code">havanoposdesk.sale.return</field>
            <field name="prefix">CRN/%(y)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for Shifts -->
        <record id="seq_havanoposdesk_shift" model="ir.sequence">
            <field name="name">Shift Sequence</field>
            <field name="code">havanoposdesk.shift</field>
            <field name="prefix">SHF/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Cash Transfers -->
        <record id="seq_havanoposdesk_cash_transfer" model="ir.sequence">
            <field name="name">Cash Transfer Sequence</field>
            <field name="code">havanoposdesk.cash.transfer</field>
            <field name="prefix">CTR-</field>
            <field name="padding">5</field>
            <field name="number_next">10001</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
