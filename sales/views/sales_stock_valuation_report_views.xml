<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sales &stock Valuation Report List View -->
        <record id="view_sales_stock_valuation_report_list" model="ir.ui.view">
            <field name="name">havanoposdesk.sales.stock.valuation.report.list</field>
            <field name="model">havanoposdesk.sales.stock.valuation.report</field>
            <field name="arch" type="xml">
                <list string="Sales &amp;stock Valuation" create="false" edit="false" delete="false">
                    <field name="currency_id" column_invisible="True"/>
                    <field name="store_id" optional="show"/>
                    <field name="pricelist_id" optional="show"/>
                    <field name="closing_stock" sum="Total Closing Stock" optional="show"/>
                    <field name="valuation_amount" widget="monetary" sum="Total Valuation" optional="show"/>
                    <field name="sales_amount" widget="monetary" sum="Total Sales" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Sales &stock Valuation Report Kanban View (Primary View) -->
        <record id="view_sales_stock_valuation_report_kanban" model="ir.ui.view">
            <field name="name">havanoposdesk.sales.stock.valuation.report.kanban</field>
            <field name="model">havanoposdesk.sales.stock.valuation.report</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1" create="0" delete="0">
                    <field name="currency_id"/>
                    <field name="store_id"/>
                    <field name="store_name"/>
                    <field name="pricelist_id"/>
                    <field name="pricelist_name"/>
                    <field name="closing_stock"/>
                    <field name="valuation_amount"/>
                    <field name="sales_amount"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click p-3 rounded-3 shadow-sm border border-light" style="background: linear-gradient(135deg, #ffffff 0%, #f9fbfd 100%);">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: #eef2ff; color: #4f46e5;">
                                            <i class="fa fa-tag"/>
                                        </div>
                                        <div>
                                            <strong class="fs-6 text-dark d-block">
                                                <field name="pricelist_id"/>
                                            </strong>
                                            <small class="text-muted">
                                                <i class="fa fa-building-o me-1"/>
                                                <field name="store_id"/>
                                            </small>
                                        </div>
                                    </div>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-semibold">
                                        Pricelist
                                    </span>
                                </div>

                                <div class="row g-2 my-2">
                                    <div class="col-6">
                                        <div class="p-2 rounded-2 text-center" style="background-color: #f1f5f9;">
                                            <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 10px; letter-spacing: 0.5px;">Closing Stock</small>
                                            <span class="fs-6 fw-bold text-dark">
                                                <field name="closing_stock"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 rounded-2 text-center" style="background-color: #ecfdf5;">
                                            <small class="text-success text-uppercase fw-bold d-block" style="font-size: 10px; letter-spacing: 0.5px;">Actual Sales</small>
                                            <span class="fs-6 fw-bold text-success">
                                                <field name="sales_amount" widget="monetary"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-2 mt-2 rounded-2 border text-center" style="background: linear-gradient(135deg, #f0f7ff 0%, #e0effe 100%); border-color: #bae6fd !important;">
                                    <small class="text-primary text-uppercase fw-bold d-block" style="font-size: 10px; letter-spacing: 0.5px;">Stock Valuation</small>
                                    <span class="fs-5 fw-bolder text-primary">
                                        <field name="valuation_amount" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Sales &stock Valuation Report Pivot View -->
        <record id="view_sales_stock_valuation_report_pivot" model="ir.ui.view">
            <field name="name">havanoposdesk.sales.stock.valuation.report.pivot</field>
            <field name="model">havanoposdesk.sales.stock.valuation.report</field>
            <field name="arch" type="xml">
                <pivot string="Sales &amp;stock Valuation" disable_linking="True">
                    <field name="store_id" type="row"/>
                    <field name="pricelist_id" type="col"/>
                    <field name="closing_stock" type="measure"/>
                    <field name="valuation_amount" type="measure"/>
                    <field name="sales_amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Sales &stock Valuation Report Search View -->
        <record id="view_sales_stock_valuation_report_search" model="ir.ui.view">
            <field name="name">havanoposdesk.sales.stock.valuation.report.search</field>
            <field name="model">havanoposdesk.sales.stock.valuation.report</field>
            <field name="arch" type="xml">
                <search string="Search Sales &amp;stock Valuation">
                    <field name="store_id"/>
                    <field name="pricelist_id"/>
                    <separator/>
                    <filter string="Has Stock" name="filter_has_stock" domain="[('closing_stock', '>', 0)]"/>
                    <filter string="Has Sales" name="filter_has_sales" domain="[('sales_amount', '>', 0)]"/>
                    <group>
                        <filter string="Store" name="group_by_store" context="{'group_by':'store_id'}"/>
                        <filter string="Pricelist" name="group_by_pricelist" context="{'group_by':'pricelist_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for Sales &stock Valuation Report -->
        <record id="action_sales_stock_valuation_report" model="ir.actions.act_window">
            <field name="name">Sales &amp;stock Valuation</field>
            <field name="res_model">havanoposdesk.sales.stock.valuation.report</field>
            <field name="view_mode">kanban,list,pivot</field>
            <field name="search_view_id" ref="view_sales_stock_valuation_report_search"/>
            <field name="context">{'search_default_group_by_store': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sales &amp; stock valuation data available.
                </p>
                <p>
                    Closing stock valuation and actual sales will appear here dynamically by store and pricelist.
                </p>
            </field>
        </record>

        <!-- Menu Item under Sales -> Reports -->
        <menuitem id="menu_sales_stock_valuation_report" 
                  name="Sales &amp;stock Valuation" 
                  parent="menu_sales_reports" 
                  action="action_sales_stock_valuation_report" 
                  sequence="35"/>
    </data>
</odoo>
