<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        
        <record id="view_havanoposdesk_sale_return_wizard_form" model="ir.ui.view">
            <field name="name">havanoposdesk.sale.return.wizard.form</field>
            <field name="model">havanoposdesk.sale.return.wizard</field>
            <field name="arch" type="xml">
                <form string="Credit Note / Return">
                    <sheet>
                        <p class="text-muted">
                            Enter the quantity of each item you wish to return. A new Credit Note will be generated, and stock will be returned to inventory.
                        </p>
                        <group>
                            <group>
                                <field name="sale_id" readonly="1" class="border-bottom border-dark" />
                            </group>
                            <group>
                                <field name="payment_status_display" widget="radio" options="{'horizontal': true}"/>
                                <field name="payment_policy" invisible="payment_status_display != 'cash'" widget="radio" options="{'horizontal': true}" />
                                <field name="account_id" invisible="payment_status_display != 'cash' or payment_policy != 'single'" required="payment_status_display == 'cash' and payment_policy == 'single'" options="{'no_create': True, 'no_open': True}"/>
                                <field name="single_payment_amount" invisible="payment_status_display != 'cash' or payment_policy != 'single'" />
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="product_id" readonly="1" force_save="1" />
                                <field name="qty_sold" readonly="1" force_save="1" />
                                <field name="qty_returned" />
                                <field name="rate" readonly="1" force_save="1" />
                                <field name="tax_ids" widget="many2many_tags" readonly="1" force_save="1" />
                                <field name="price_subtotal" sum="Total Subtotal" />
                                <field name="price_tax" sum="Total Tax" />
                                <field name="amount" sum="Total Return" optional="show" />
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_confirm_return" string="Create Credit Note" type="object" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        
        <record id="action_havanoposdesk_sale_return_wizard" model="ir.actions.act_window">
            <field name="name">Credit Note</field>
            <field name="res_model">havanoposdesk.sale.return.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_havanoposdesk_sale" />
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>