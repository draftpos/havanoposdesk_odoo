<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Admin list/tree view inherit -->
        <record id="view_users_tree_inherit_havano" model="ir.ui.view">
            <field name="name">res.users.tree.inherit.havano</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="default_store_id" string="Default Store" optional="show"/>
                    <field name="store_ids" string="Allowed Stores" widget="many2many_tags" optional="show"/>
                    <field name="pricelist_id" string="Default Pricelist" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Admin form view (full editable, for super_admin viewing a user's record) -->
        <record id="view_users_form_inherit_havano" model="ir.ui.view">
            <field name="name">res.users.form.inherit.havano</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Havano SaaS" name="havano_saas">
                        <group>
                            <group string="SaaS Credentials">
                                <field name="havano_role"/>
                                <field name="tenant_id" options="{'no_create': True}" invisible="havano_role == 'super_admin'"/>
                            </group>
                            <group string="Email Verification" invisible="havano_role == 'super_admin'">
                                <field name="verification_token" readonly="1"/>
                                <field name="verification_sent_at" readonly="1"/>
                            </group>
                            <group string="Store Access" invisible="havano_role == 'super_admin'">
                                <field name="store_ids" widget="many2many_tags" domain="[('tenant_id', '=', tenant_id)]" required="havano_role != 'super_admin'" options="{'no_create': True}"/>
                                <field name="default_store_id" domain="[('tenant_id', '=', tenant_id)]" required="havano_role != 'super_admin'" options="{'no_create': True}"/>
                                <field name="allowed_pricelist_ids" invisible="1"/>
                                <field name="pricelist_id" domain="[('id', 'in', allowed_pricelist_ids)]" required="havano_role != 'super_admin'" options="{'no_create': True}" readonly="not default_store_id"/>
                            </group>
                            <group string="API &amp; Integration Settings">
                                <field name="api_company_name"/>
                                <field name="api_currency"/>
                                <field name="api_uom"/>
                                <field name="api_cost_center" placeholder="Defaults to default store if blank"/>
                                <field name="api_warehouse" placeholder="Defaults to default store if blank"/>
                            </group>
                            <group string="POS Settings">
                                <field name="allow_discount"/>
                                <field name="max_discount_percent"/>
                                <field name="require_shift"/>
                                <field name="pin"/>
                                <field name="user_rights_profile_id" domain="[('tenant_id', '=', tenant_id)]" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- My Preferences modal - single, clean Havano SaaS tab (no duplicates) -->
        <record id="view_users_form_simple_modif_inherit_havano" model="ir.ui.view">
            <field name="name">res.users.preferences.form.inherit.havano</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Havano SaaS" name="havano_saas">
                        <group>
                            <group string="SaaS Credentials">
                                <field name="havano_role" readonly="1"/>
                                <field name="tenant_id" readonly="1" invisible="havano_role == 'super_admin'"/>
                            </group>
                            <group string="Store Access" invisible="havano_role == 'super_admin'">
                                <field name="store_ids" widget="many2many_tags" domain="[('tenant_id', '=', tenant_id)]" required="havano_role != 'super_admin'" options="{'no_create': True}"/>
                                <field name="default_store_id" domain="[('tenant_id', '=', tenant_id)]" required="havano_role != 'super_admin'" options="{'no_create': True}"/>
                                <field name="allowed_pricelist_ids" invisible="1"/>
                                <field name="pricelist_id" domain="[('id', 'in', allowed_pricelist_ids)]" required="havano_role != 'super_admin'" options="{'no_create': True}" readonly="not default_store_id"/>
                            </group>
                            <group string="API &amp; Integration Settings">
                                <field name="api_company_name"/>
                                <field name="api_currency"/>
                                <field name="api_uom"/>
                                <field name="api_cost_center" placeholder="Defaults to default store if blank"/>
                                <field name="api_warehouse" placeholder="Defaults to default store if blank"/>
                            </group>
                            <group string="POS Settings">
                                <field name="allow_discount"/>
                                <field name="max_discount_percent"/>
                                <field name="require_shift"/>
                                <field name="pin"/>
                                <field name="user_rights_profile_id" domain="[('tenant_id', '=', tenant_id)]" options="{'no_create': True}" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
