<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        
        <record id="view_pos_terminal_tree" model="ir.ui.view">
            <field name="name">pos.terminal.tree</field>
            <field name="model">havanoposdesk.pos.terminal</field>
            <field name="arch" type="xml">
                <list string="POS Terminals">
                    <field name="id" string="Terminal ID" readonly="1" optional="show" />
                    <field name="name" />
                    <field name="store_id" />
                    <field name="sequence_prefix" />
                    <field name="device_hardware_id" readonly="1" />
                    <field name="app_version" readonly="1" />
                    <field name="last_logged_in_user_id" />
                    <field name="status" optional="show" />
                    <field name="last_seen" optional="show" />
                    <field name="active" widget="boolean_toggle" optional="show" />
                </list>
            </field>
        </record>

        
        <record id="view_pos_terminal_form" model="ir.ui.view">
            <field name="name">pos.terminal.form</field>
            <field name="model">havanoposdesk.pos.terminal</field>
            <field name="arch" type="xml">
                <form string="POS Terminal">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1" />
                                <field name="store_id" domain="[('tenant_id', '=', tenant_id)]" options="{'no_create': True}" />
                                <field name="device_hardware_id" readonly="1" />
                                <field name="app_version" readonly="1" />
                            </group>
                            <group>
                                <field name="sequence_prefix" readonly="1" />
                                <field name="status" readonly="1" />
                                <field name="last_seen" readonly="1" />
                                <field name="active" widget="boolean_toggle" />
                                <field name="last_logged_in_user_id" string="Last Logged In By" readonly="1" />
                                <field name="tenant_id" invisible="1" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        
        <!-- Search View for POS Terminals with Inactivity Tracking -->
        <record id="view_pos_terminal_search" model="ir.ui.view">
            <field name="name">pos.terminal.search</field>
            <field name="model">havanoposdesk.pos.terminal</field>
            <field name="arch" type="xml">
                <search string="Search POS Terminals">
                    <field name="name" string="Terminal Name"/>
                    <field name="store_id" string="Store"/>
                    <field name="tenant_id" string="Tenant"/>
                    <field name="device_hardware_id" string="Hardware ID"/>
                    <field name="app_version" string="App Version"/>
                    <field name="last_logged_in_user_id" string="User"/>
                    <field name="last_seen" string="Date Range (Last Seen)"/>

                    <separator/>
                    <filter string="Online Now" name="filter_online" domain="[('status', '=', 'online')]"/>
                    <filter string="Offline" name="filter_offline" domain="[('status', 'in', ('offline', 'closed'))]"/>

                    <separator/>
                    <filter string="Active Today" name="filter_active_today" domain="[('last_seen', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Active Last 24 Hours" name="filter_active_24h" domain="[('last_seen', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>

                    <separator/>
                    <filter string="Not Used Today (Inactive Today)" name="filter_inactive_today" domain="['|', ('last_seen', '&lt;', context_today().strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used Since Yesterday (≥ 1 Day)" name="filter_inactive_yesterday" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 2 Days (≥ 2 Days)" name="filter_inactive_2_days" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=2)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 3 Days (≥ 3 Days)" name="filter_inactive_3_days" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=3)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 4 Days (≥ 4 Days)" name="filter_inactive_4_days" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=4)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 7 Days (≥ 1 Week)" name="filter_inactive_7_days" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 10 Days (≥ 10 Days)" name="filter_inactive_10_days" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=10)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 14 Days (≥ 2 Weeks)" name="filter_inactive_14_days" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Not Used in Last 1 Month (≥ 30 Days)" name="filter_inactive_1_month" domain="['|', ('last_seen', '&lt;', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00')), ('last_seen', '=', False)]"/>
                    <filter string="Never Connected" name="filter_never_active" domain="[('last_seen', '=', False)]"/>

                    <separator/>
                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Archived / Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>

                    <group>
                        <filter string="Tenant" name="group_tenant" context="{'group_by': 'tenant_id'}"/>
                        <filter string="Store" name="group_store" context="{'group_by': 'store_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_pos_terminals" model="ir.actions.act_window">
            <field name="name">POS Terminals</field>
            <field name="res_model">havanoposdesk.pos.terminal</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_pos_terminal_tree" />
            <field name="search_view_id" ref="view_pos_terminal_search" />
            <field name="context">{'active_test': False, 'search_default_filter_active': 1, 'search_default_group_tenant': 1}</field>
        </record>

    </data>
</odoo>