<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        
        <record id="view_pos_terminal_tree" model="ir.ui.view">
            <field name="name">pos.terminal.tree</field>
            <field name="model">havanoposdesk.pos.terminal</field>
            <field name="arch" type="xml">
                <list string="POS Terminals" create="0">
                    <header>
                        <button name="action_add_terminal" string="Add Terminal" type="object" class="btn-primary"/>
                    </header>
                    <field name="name" />
                    <field name="store_id" />
                    <field name="sequence_prefix" />
                    <field name="device_hardware_id" readonly="1" />
                    <field name="user_id" optional="show" />
                    <field name="last_logged_in_user_id" />
                    <field name="status" optional="show" />
                    <field name="last_seen" optional="show" />
                    <field name="active" widget="boolean_toggle" optional="show" />
                </list>
            </field>
        </record>

        
        <record id="view_pos_terminal_form" model="ir.ui.view">
            <field name="name">pos.terminal.form</field>
            <field name="model">havanoposdesk.pos.terminal</field>
            <field name="arch" type="xml">
                <form string="POS Terminal" create="0">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1" />
                                <field name="store_id" domain="[('tenant_id', '=', tenant_id)]" options="{'no_create': True}" />
                                <field name="device_hardware_id" readonly="1" />
                                <field name="user_id" />
                            </group>
                            <group>
                                <field name="sequence_prefix" />
                                <field name="status" />
                                <field name="last_seen" readonly="1" />
                                <field name="active" widget="boolean_toggle" />
                                <field name="last_logged_in_user_id" string="Last Logged In By" />
                                <field name="tenant_id" invisible="1" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Hardware Information">
                                <group>
                                    <div class="alert alert-info" role="alert" style="margin-bottom:0px;">
                                        <strong>Settings.Secure.ANDROID_ID Information:</strong>
                                        <table class="table table-sm table-borderless" style="margin-top: 10px; margin-bottom: 0px;">
                                            <tr>
                                                <td style="width: 150px; font-weight: bold;">Identifier:</td>
                                                <td>Settings.Secure.ANDROID_ID</td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight: bold;">How It Works:</td>
                                                <td>A 64-bit hex string generated on first device boot.</td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight: bold;">Persistence:</td>
                                                <td>Resets on factory reset. Remains constant across app updates/reinstalls.</td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight: bold;">Key Notes:</td>
                                                <td>Unique hardware identification key for Android POS terminals. For iOS/other platforms, vendor or persistent identifiers are used.</td>
                                            </tr>
                                        </table>
                                    </div>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        
        <record id="action_pos_terminals" model="ir.actions.act_window">
            <field name="name">POS Terminals</field>
            <field name="res_model">havanoposdesk.pos.terminal</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_pos_terminal_tree" />
        </record>
    </data>
</odoo>