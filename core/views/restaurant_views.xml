<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Floors -->
        <record id="havanoposdesk_restaurant_floor_view_tree" model="ir.ui.view">
            <field name="name">havanoposdesk.restaurant.floor.tree</field>
            <field name="model">havanoposdesk.restaurant.floor</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="havanoposdesk_restaurant_floor_view_form" model="ir.ui.view">
            <field name="name">havanoposdesk.restaurant.floor.form</field>
            <field name="model">havanoposdesk.restaurant.floor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <notebook>
                            <page string="Tables">
                                <field name="table_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="seats"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="havanoposdesk_restaurant_floor_action" model="ir.actions.act_window">
            <field name="name">Floors</field>
            <field name="res_model">havanoposdesk.restaurant.floor</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Tables -->
        <record id="havanoposdesk_restaurant_table_view_tree" model="ir.ui.view">
            <field name="name">havanoposdesk.restaurant.table.tree</field>
            <field name="model">havanoposdesk.restaurant.table</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="floor_id"/>
                    <field name="seats"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="havanoposdesk_restaurant_table_view_form" model="ir.ui.view">
            <field name="name">havanoposdesk.restaurant.table.form</field>
            <field name="model">havanoposdesk.restaurant.table</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="floor_id"/>
                            <field name="seats"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="havanoposdesk_restaurant_table_action" model="ir.actions.act_window">
            <field name="name">Tables</field>
            <field name="res_model">havanoposdesk.restaurant.table</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Waiters -->
        <record id="havanoposdesk_restaurant_waiter_view_tree" model="ir.ui.view">
            <field name="name">havanoposdesk.restaurant.waiter.tree</field>
            <field name="model">havanoposdesk.restaurant.waiter</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="pin"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="havanoposdesk_restaurant_waiter_view_form" model="ir.ui.view">
            <field name="name">havanoposdesk.restaurant.waiter.form</field>
            <field name="model">havanoposdesk.restaurant.waiter</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="pin"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="havanoposdesk_restaurant_waiter_action" model="ir.actions.act_window">
            <field name="name">Waiters</field>
            <field name="res_model">havanoposdesk.restaurant.waiter</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_restaurant_settings_root" name="Restaurant Settings" parent="menu_tenant_admin_settings_root" sequence="200" groups="base.group_system,havanoposdesk_odoo.group_tenant_admin"/>
        
        <menuitem id="menu_restaurant_floors" name="Floors" parent="menu_restaurant_settings_root" action="havanoposdesk_restaurant_floor_action" sequence="10"/>
        <menuitem id="menu_restaurant_tables" name="Tables" parent="menu_restaurant_settings_root" action="havanoposdesk_restaurant_table_action" sequence="20"/>
        <menuitem id="menu_restaurant_waiters" name="Waiters" parent="menu_restaurant_settings_root" action="havanoposdesk_restaurant_waiter_action" sequence="30"/>

    </data>
</odoo>
