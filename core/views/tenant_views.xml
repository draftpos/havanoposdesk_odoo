<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_havanoposdesk_tenant_tree" model="ir.ui.view">
            <field name="name">havanoposdesk.tenant.tree</field>
            <field name="model">havanoposdesk.tenant</field>
            <field name="arch" type="xml">
                <list string="Tenants &amp; Activity"
                      decoration-success="online_status == 'online'"
                      decoration-warning="online_status == 'idle'"
                      decoration-muted="online_status == 'offline'">
                    <field name="online_status" widget="badge"
                           decoration-success="online_status == 'online'"
                           decoration-warning="online_status == 'idle'"
                           decoration-danger="online_status == 'offline'" string="Status" optional="show"/>
                    <field name="name" string="Tenant Name" optional="show"/>
                    <field name="id" string="Tenant ID" optional="show"/>
                    <field name="last_logged_in_user_id" string="Last User" optional="show"/>
                    <field name="last_activity" string="Last Active / Seen" optional="show"/>
                    <field name="days_inactive_display" string="Inactive Duration" widget="badge"
                           decoration-success="days_inactive == 0"
                           decoration-warning="days_inactive &gt; 0 and days_inactive &lt;= 3"
                           decoration-danger="days_inactive &gt; 3" optional="show"/>
                    <field name="admin_name" string="Admin Name" optional="show"/>
                    <field name="email" string="Email" optional="show"/>
                    <field name="phone" string="Phone" optional="show"/>
                    <field name="address" string="Address" optional="hide"/>
                    <field name="city" string="City" optional="hide"/>
                    <field name="sales_rep" string="Sales Rep" optional="hide"/>
                    <field name="technician" string="Technician" optional="hide"/>
                    <field name="owner_whatsapp" string="Verified WhatsApp (Owner)" optional="show"/>
                    <field name="subscription_plan_id" optional="show"/>
                    <field name="account_balance" optional="show"/>
                    <field name="pending_topup_count" string="Pending Top-Ups" widget="badge" decoration-warning="pending_topup_count &gt; 0" optional="hide"/>
                    <field name="subscription_state"
                           widget="badge"
                           decoration-success="subscription_state == 'active'"
                           decoration-warning="subscription_state == 'expired'"
                           decoration-danger="subscription_state == 'cancelled'" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_havanoposdesk_tenant_form" model="ir.ui.view">
            <field name="name">havanoposdesk.tenant.form</field>
            <field name="model">havanoposdesk.tenant</field>
            <field name="arch" type="xml">
                <form string="Tenant">
                    <header>
                        <field name="pending_subscription_plan_id" invisible="1"/>
                        <field name="pending_topup_count" invisible="1"/>
                        <button name="action_approve_pending_topup"
                                type="object"
                                string="Approve Pending Top-Up"
                                class="btn-success oe_highlight"
                                invisible="pending_topup_count == 0"
                                groups="base.group_system"/>

                        <button name="action_approve"
                                type="object"
                                string="Approve / Activate Plan"
                                class="oe_highlight"
                                invisible="subscription_state == 'active' and not pending_subscription_plan_id"
                                groups="base.group_system"/>

                        <button name="action_expire"
                                type="object"
                                string="Set Expired"
                                invisible="subscription_state == 'expired'"
                                groups="base.group_system"/>

                        <button name="action_cancel"
                                type="object"
                                string="Cancel Subscription"
                                class="btn-danger"
                                invisible="subscription_state == 'cancelled'"
                                groups="base.group_system"/>

                        <button name="action_cancel"
                                type="object"
                                string="Cancel Pending Request"
                                class="btn-secondary"
                                invisible="subscription_state != 'pending' and not pending_subscription_plan_id"/>

                        <button name="action_topup_wizard"
                                type="object"
                                string="Top Up Balance"
                                class="btn-info"/>

                        <button name="action_pay_from_balance"
                                type="object"
                                string="Pay Plan from Balance"
                                class="btn-success"
                                invisible="(subscription_state == 'active' and not pending_subscription_plan_id) or (not subscription_plan_id and not pending_subscription_plan_id)"/>

                        <button name="action_pay_subscription_wizard"
                                type="object"
                                string="Pay Online (Paynow/EcoCash)"
                                class="btn-primary"
                                invisible="(subscription_state == 'active' and not pending_subscription_plan_id) or (not subscription_plan_id and not pending_subscription_plan_id)"/>

                        <button name="action_upgrade_plan"
                                type="object"
                                string="Change/Upgrade Plan"
                                class="oe_highlight"
                                invisible="subscription_state == 'pending' or pending_subscription_plan_id"/>

                        <button name="action_open_delete_wizard"
                                type="object"
                                string="Delete Tenant"
                                class="btn-danger"
                                icon="fa-trash"
                                groups="base.group_system"/>

                        <field name="subscription_state"
                               widget="statusbar"
                               statusbar_visible="active,pending,expired,cancelled"/>
                    </header>

                    <sheet>
                        <group string="Pending Plan Upgrade Request" invisible="not pending_subscription_plan_id">
                            <field name="pending_subscription_plan_id" readonly="1" options="{'no_create': True}"/>
                            <field name="pending_billing_cycle" readonly="1"/>
                            <field name="pending_duration_months" readonly="1" invisible="pending_billing_cycle != 'custom_months'"/>
                            <field name="pending_additional_terminals" readonly="1"/>
                            <field name="pending_additional_stores" readonly="1"/>
                            <field name="pending_subscription_total_amount" readonly="1"/>
                        </group>
                        <group>
                            <group string="Active Subscription &amp; Wallet">
                                <field name="name"
                                        readonly="not context.is_super_admin"/>
                                    <field name="account_balance" readonly="not context.is_super_admin"/>
                                <field name="subscription_plan_id"
                                       options="{'no_create': True}"
                                        readonly="not context.is_super_admin"/>
                                    <field name="billing_cycle" readonly="not context.is_super_admin"/>
                                    <field name="duration_months" readonly="not context.is_super_admin" invisible="billing_cycle != 'custom_months'"/>
                                    <field name="additional_terminals" readonly="not context.is_super_admin"/>
                                    <field name="additional_stores" readonly="not context.is_super_admin"/>
                                <field name="effective_max_stores" readonly="1"/>
                                <field name="effective_max_terminals" readonly="1"/>
                                <field name="subscription_total_amount" readonly="1"/>
                                <field name="payment_status" readonly="not context.is_super_admin"/>
                            </group>

                            <group string="Duration &amp; Status">
                                <field name="subscription_start_date" readonly="1"/>
                                <field name="subscription_end_date" readonly="1"/>
                                <field name="active"
                                       readonly="not context.is_super_admin"/>
                            </group>
                            <group string="Features">
                                <field name="restaurant_mode_enabled" widget="boolean_toggle"/>
                            </group>
                            <group string="Tenant Profile &amp; Contact Information">
                                <field name="admin_name"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="owner_whatsapp"/>
                                <field name="address"/>
                                <field name="city"/>
                                <field name="sales_rep"/>
                                <field name="technician"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Transaction History &amp; Top-Ups" name="transaction_history">
                                <field name="subscription_payment_ids" readonly="1">
                                    <list string="Payments &amp; Top-Up Log" default_order="date desc" decoration-success="state == 'done'" decoration-warning="state == 'pending'" decoration-danger="state == 'failed'">
                                        <field name="date"/>
                                        <field name="payment_type"/>
                                        <field name="billing_cycle" optional="show"/>
                                        <field name="duration_months" optional="show"/>
                                        <field name="amount" sum="Total Amount"/>
                                        <field name="payment_method"/>
                                        <field name="transaction_reference"/>
                                        <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'pending'" decoration-danger="state == 'failed'"/>
                                        <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'pending'" groups="base.group_system"/>
                                        <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending'" groups="base.group_system"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                        <group string="API &amp; Integration Settings" invisible="1">
                            <group>
                                <field name="api_company_name"/>
                                <field name="api_currency"/>
                                <field name="api_uom"/>
                            </group>
                            <group>
                                <field name="api_cost_center" placeholder="Defaults to Store name if blank"/>
                                <field name="api_warehouse" placeholder="Defaults to Store name if blank"/>
                            </group>
                        </group>
                        <group string="Feature Toggles" invisible="1">
                            <group>
                                <field name="enable_tax" widget="boolean_toggle"/>
                                <field name="enable_barcode" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tenant Search View -->
        <record id="view_havanoposdesk_tenant_search" model="ir.ui.view">
            <field name="name">havanoposdesk.tenant.search</field>
            <field name="model">havanoposdesk.tenant</field>
            <field name="arch" type="xml">
                <search string="Tenants">
                    <field name="name" string="Tenant Name"/>
                    <field name="subscription_plan_id" string="Subscription Plan"/>
                    <field name="subscription_state" string="Subscription State"/>
                    <field name="currency_id" string="Currency"/>

                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Archived / Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>
                    <separator/>

                    <filter string="Subscription: Active" name="filter_state_active" domain="[('subscription_state', '=', 'active')]"/>
                    <filter string="Subscription: Pending" name="filter_state_pending" domain="[('subscription_state', '=', 'pending')]"/>
                    <filter string="Subscription: Expired" name="filter_state_expired" domain="[('subscription_state', '=', 'expired')]"/>
                    <filter string="Subscription: Cancelled" name="filter_state_cancelled" domain="[('subscription_state', '=', 'cancelled')]"/>
                    <separator/>

                    <filter string="Paid Tenants" name="filter_paid" domain="[('is_trial', '=', False)]"/>
                    <filter string="Trial / Demo Tenants" name="filter_trial" domain="[('is_trial', '=', True)]"/>
                    <separator/>

                    <filter string="Has Pending Top-Ups" name="filter_pending_topups" domain="[('pending_topup_count', '>', 0)]"/>
                    <filter string="Positive Balance (> $0)" name="filter_positive_balance" domain="[('account_balance', '>', 0)]"/>
                    <filter string="Zero Balance" name="filter_zero_balance" domain="[('account_balance', '=', 0)]"/>
                    <separator/>

                    <filter string="Fiscalization Enabled" name="filter_fiscal" domain="[('enable_fiscalization', '=', True)]"/>
                    <filter string="Restaurant Mode" name="filter_restaurant" domain="[('restaurant_mode_enabled', '=', True)]"/>
                    <separator/>

                    <filter string="Online Now" name="filter_online" domain="[('online_status', '=', 'online')]"/>
                    <filter string="Idle (5-15m)" name="filter_idle" domain="[('online_status', '=', 'idle')]"/>
                    <filter string="Offline" name="filter_offline" domain="[('online_status', '=', 'offline')]"/>
                    <separator/>

                    <filter string="Active Today" name="filter_active_today" domain="[('last_activity', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Active Last 24 Hours" name="filter_active_24h" domain="[('last_activity', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <separator/>

                    <filter string="Not Used Today (Inactive Today)" name="filter_inactive_today" domain="['|', ('last_activity', '&lt;', context_today().strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used Since Yesterday (≥ 1 Day)" name="filter_inactive_yesterday" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 2 Days (≥ 2 Days)" name="filter_inactive_2_days" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=2)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 3 Days (≥ 3 Days)" name="filter_inactive_3_days" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=3)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 4 Days (≥ 4 Days)" name="filter_inactive_4_days" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=4)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 7 Days (≥ 1 Week)" name="filter_inactive_7_days" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 10 Days (≥ 10 Days)" name="filter_inactive_10_days" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=10)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 14 Days (≥ 2 Weeks)" name="filter_inactive_14_days" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Not Used in Last 1 Month (≥ 30 Days)" name="filter_inactive_1_month" domain="['|', ('last_activity', '&lt;', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00')), ('last_activity', '=', False)]"/>
                    <filter string="Never Used System" name="filter_never_active" domain="[('last_activity', '=', False)]"/>

                    <group>
                        <filter string="Tenant Name" name="group_by_name" context="{'group_by': 'name'}"/>
                        <filter string="Online Status" name="group_by_online_status" context="{'group_by': 'online_status'}"/>
                        <filter string="Subscription Plan" name="group_by_plan" context="{'group_by': 'subscription_plan_id'}"/>
                        <filter string="Subscription State" name="group_by_state" context="{'group_by': 'subscription_state'}"/>
                        <filter string="Billing Cycle" name="group_by_billing_cycle" context="{'group_by': 'billing_cycle'}"/>
                        <filter string="Trial vs Paid" name="group_by_trial" context="{'group_by': 'is_trial'}"/>
                        <filter string="Default Currency" name="group_by_currency" context="{'group_by': 'currency_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tenant Upgrade Wizard View -->
        <record id="view_tenant_upgrade_wizard_form" model="ir.ui.view">
            <field name="name">havanoposdesk.tenant.upgrade.wizard.form</field>
            <field name="model">havanoposdesk.tenant.upgrade.wizard</field>
            <field name="arch" type="xml">
                <form string="Change / Upgrade Plan">
                    <group>
                        <field name="subscription_plan_id"
                               options="{'no_create': True}"/>
                        <field name="billing_cycle"/>
                        <field name="duration_months"
                               invisible="billing_cycle != 'custom_months'"
                               required="billing_cycle == 'custom_months'"/>
                        <field name="is_custom" invisible="1"/>
                        <field name="extra_terminal_price" invisible="1"/>
                        <field name="additional_terminals"
                               invisible="not is_custom"
                               required="is_custom"/>
                        <field name="additional_stores"
                               readonly="1"
                               invisible="not is_custom"
                               string="Included Stores Allowance"/>
                        <field name="monthly_price" readonly="1"/>
                        <field name="computed_total_price" readonly="1" string="Total Amount ($)"/>
                    </group>
                    <footer>
                        <button string="Confirm Upgrade"
                                name="action_confirm"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Subscription Payment Wizard View -->
        <record id="view_havanoposdesk_subscription_pay_wizard_form" model="ir.ui.view">
            <field name="name">havanoposdesk.subscription.pay.wizard.form</field>
            <field name="model">havanoposdesk.subscription.pay.wizard</field>
            <field name="arch" type="xml">
                <form string="Pay Subscription">
                    <group>
                        <field name="tenant_id" invisible="1"/>
                        <field name="subscription_plan_id" readonly="1"/>
                        <field name="billing_cycle"/>
                        <field name="duration_months"
                               invisible="billing_cycle != 'custom_months'"
                               required="billing_cycle == 'custom_months'"/>
                        <field name="monthly_rate" readonly="1"/>
                        <field name="amount" readonly="1"/>
                        <field name="payment_method" widget="radio"/>
                        <field name="phone" placeholder="e.g. 0771234567" invisible="payment_method != 'ecocash'" required="payment_method == 'ecocash'"/>
                    </group>
                    <footer>
                        <button string="Initiate Payment" name="action_pay" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <!-- Top Up Account Balance Wizard View -->
        <record id="view_havanoposdesk_tenant_topup_wizard_form" model="ir.ui.view">
            <field name="name">havanoposdesk.tenant.topup.wizard.form</field>
            <field name="model">havanoposdesk.tenant.topup.wizard</field>
            <field name="arch" type="xml">
                <form string="Top Up Account Balance">
                    <group>
                        <field name="tenant_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="payment_method" widget="radio"/>
                        <field name="phone" placeholder="e.g. 0771234567" invisible="payment_method != 'ecocash'" required="payment_method == 'ecocash'"/>
                    </group>
                    <footer>
                        <button string="Top Up Balance" name="action_topup" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
