<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Store List (Tree) View -->
        <record id="view_havanoposdesk_store_tree" model="ir.ui.view">
            <field name="name">havanoposdesk.store.tree</field>
            <field name="model">havanoposdesk.store</field>
            <field name="arch" type="xml">
                <list string="Stores">
                    <field name="name"/>
                    <field name="tenant_id" column_invisible="1"/>
                    <field name="pricelist_id"/>
                    <field name="tz" optional="show"/>
                    <field name="terminal_count"/>
                    <field name="last_open"/>
                    <field name="sales_count"/>
                    <field name="purchases_count"/>
                    <field name="sale_value"/>
                    <field name="users_count"/>
                    <field name="active" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Store Form View -->
        <record id="view_havanoposdesk_store_form" model="ir.ui.view">
            <field name="name">havanoposdesk.store.form</field>
            <field name="model">havanoposdesk.store</field>
            <field name="arch" type="xml">
                <form string="Store">
                    <header>
                    </header>
                    <sheet>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="name"/>
                                        <field name="tenant_id" invisible="1"/>
                                        <field name="currency_id" domain="[('tenant_id', '=', tenant_id)]" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="tz" required="1"/>
                                        <field name="pricelist_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                        <field name="pricelist_id" options="{'no_create': True}" required="1"/>
                                    </group>
                                    <group>
                                        <field name="active"/>
                                        <field name="is_default" readonly="is_default"/>
                                        <field name="auto_populate_data"/>
                                    </group>
                                </group>
                            </page>
                            <page string="More Info">
                                <group>
                                    <group string="Contact Info">
                                        <field name="address"/>
                                        <field name="phone_1"/>
                                        <field name="phone_2"/>
                                        <field name="email"/>
                                        <field name="website"/>
                                    </group>
                                    <group string="Tax Info">
                                        <field name="tin"/>
                                        <field name="vat_no"/>
                                    </group>
                                </group>
                                <group string="Default Texts">
                                    <field name="default_terms"/>
                                    <field name="default_footer"/>
                                    <field name="powered_by_footer"/>
                                    <field name="tagline"/>
                                </group>

                                <separator string="Banking Details"/>
                                <field name="bank_account_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="account_name"/>
                                        <field name="account_number"/>
                                        <field name="branch"/>
                                        <field name="currency_id"/>
                                        <field name="show_on_invoice"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Sequence Configuration" name="sequence_config">
                                <group string="Sequence Configuration">
                                    <group string="Sales Orders">
                                        <field name="sale_seq_prefix" string="Prefix"/>
                                        <field name="sale_seq_next" string="Next Number"/>
                                        <field name="sale_seq_padding" string="Padding"/>
                                    </group>
                                    <group string="Credit Notes (Returns)">
                                        <field name="sale_ret_seq_prefix" string="Prefix"/>
                                        <field name="sale_ret_seq_next" string="Next Number"/>
                                        <field name="sale_ret_seq_padding" string="Padding"/>
                                    </group>
                                </group>
                                <group string="Quotations">
                                    <group>
                                        <field name="quotation_seq_prefix" string="Prefix"/>
                                        <field name="quotation_seq_next" string="Next Number"/>
                                        <field name="quotation_seq_padding" string="Padding"/>
                                    </group>
                                </group>
                            </page>
                            <page string="ZIMRA Fiscalization">
                                <div class="mb-3" invisible="not enable_fiscalization">
                                    <button name="action_ping_zimra_device" string="Ping ZIMRA Device" type="object" class="btn-primary"/>
                                </div>
                                <group>
                                    <group string="ZIMRA Configuration">
                                        <field name="enable_fiscalization"/>
                                        <field name="is_vat_registered" invisible="not enable_fiscalization"/>
                                        <field name="fiscal_provider" invisible="not enable_fiscalization"/>
                                        <field name="fiscal_base_url" invisible="not enable_fiscalization"/>
                                        <field name="fiscal_device_sn" invisible="not enable_fiscalization"/>
                                        <field name="fiscalized_invoice_heading" invisible="not enable_fiscalization"/>
                                    </group>
                                    <group string="API Credentials" invisible="not enable_fiscalization">
                                        <field name="fiscal_api_key" password="True"/>
                                        <field name="fiscal_api_secret" password="True"/>
                                        <field name="fiscal_ping_interval"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Subscription Management" name="subscription_page">
                                <field name="payment_status" invisible="1"/>
                                <field name="pending_subscription_plan_id" invisible="1"/>
                                
                                <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert" invisible="payment_status != 'unpaid' and subscription_state != 'pending'">
                                    <div>
                                        <i class="fa fa-exclamation-triangle me-2"/>
                                        <strong>Payment Pending:</strong> Your subscription payment is pending. Please complete payment or pay from balance to activate.
                                    </div>
                                    <div>
                                        <button name="action_pay_subscription_wizard" string="Pay Online (Paynow/EcoCash)" type="object" class="btn btn-primary btn-sm me-2" icon="fa-credit-card"/>
                                        <button name="action_pay_from_balance" string="Pay from Balance" type="object" class="btn btn-success btn-sm" icon="fa-check-circle"/>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="mb-0 text-primary fw-bold">Business Subscription &amp; Prepaid Wallet</h5>
                                        <span class="text-muted small">Subscription status and balance.</span>
                                    </div>
                                    <div>
                                        <button name="action_open_subscription" string="Open Full Subscription Page" type="object" class="btn btn-outline-primary" icon="fa-external-link"/>
                                    </div>
                                </div>

                                <group>
                                    <group string="Subscription Details">
                                        <field name="subscription_plan_id" options="{'no_open': False}"/>
                                        <field name="subscription_state" decoration-success="subscription_state == 'active'" decoration-danger="subscription_state in ('expired', 'cancelled')" decoration-warning="subscription_state == 'pending'" widget="badge"/>
                                        <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status in ('pending', 'unpaid')"/>
                                        <field name="subscription_start_date"/>
                                        <field name="subscription_end_date"/>
                                    </group>
                                    <group string="Billing &amp; Actions">
                                        <field name="account_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="subscription_total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <div class="mt-3">
                                            <button name="action_pay_subscription_wizard" string="Pay Online (Paynow/EcoCash)" type="object" class="btn btn-primary me-2 mb-2" icon="fa-credit-card" invisible="(subscription_state == 'active' and not pending_subscription_plan_id) or (not subscription_plan_id and not pending_subscription_plan_id)"/>
                                            <button name="action_pay_from_balance" string="Pay from Balance" type="object" class="btn btn-success me-2 mb-2" icon="fa-check-circle" invisible="(subscription_state == 'active' and not pending_subscription_plan_id) or (not subscription_plan_id and not pending_subscription_plan_id)"/>
                                            <button name="action_topup_account" string="Top Up Wallet Balance" type="object" class="btn btn-info me-2 mb-2" icon="fa-plus-circle"/>
                                            <button name="action_manage_subscription" string="Change / Upgrade Plan" type="object" class="btn btn-secondary me-2 mb-2" icon="fa-refresh" invisible="subscription_state == 'pending' or pending_subscription_plan_id"/>
                                            <button name="action_cancel_pending_subscription" string="Cancel Pending Request" type="object" class="btn btn-outline-danger mb-2" icon="fa-times" invisible="subscription_state != 'pending' and not pending_subscription_plan_id"/>
                                        </div>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Store Search View -->
        <record id="view_havanoposdesk_store_search" model="ir.ui.view">
            <field name="name">havanoposdesk.store.search</field>
            <field name="model">havanoposdesk.store</field>
            <field name="arch" type="xml">
                <search string="Stores">
                    <field name="name"/>
                    <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                    <filter string="Archived / Inactive" name="filter_inactive" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- Store Action -->
        <record id="action_havanoposdesk_store" model="ir.actions.act_window">
            <field name="name">Stores</field>
            <field name="res_model">havanoposdesk.store</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_havanoposdesk_store_search"/>
            <field name="context">{'active_test': False}</field>
        </record>
    </data>
</odoo>
