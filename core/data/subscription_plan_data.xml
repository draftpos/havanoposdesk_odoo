<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Plan 1: Demo Plan -->
        <record id="subscription_plan_1" model="havanoposdesk.subscription.plan">
            <field name="name">Demo Plan (10 Terminals, 10 Stores)</field>
            <field name="price">0.00</field>
            <field name="duration_days">14</field>
            <field name="max_stores">10</field>
            <field name="max_terminals">10</field>
            <field name="max_users">10</field>
            <field name="is_custom">False</field>
            <field name="is_trial">True</field>
        </record>

        <!-- Plan 2: 2 Terminals, 6 Stores -->
        <record id="subscription_plan_2" model="havanoposdesk.subscription.plan">
            <field name="name">Plan 2 (2 Terminals, 6 Stores)</field>
            <field name="price">24.00</field>
            <field name="duration_days">30</field>
            <field name="max_stores">6</field>
            <field name="max_terminals">2</field>
            <field name="max_users">5</field>
            <field name="is_custom">False</field>
        </record>

        <!-- Plan 3: 3 Terminals, 9 Stores -->
        <record id="subscription_plan_3" model="havanoposdesk.subscription.plan">
            <field name="name">Plan 3 (3 Terminals, 9 Stores)</field>
            <field name="price">36.00</field>
            <field name="duration_days">30</field>
            <field name="max_stores">9</field>
            <field name="max_terminals">3</field>
            <field name="max_users">10</field>
            <field name="is_custom">False</field>
        </record>

        <!-- Custom Plan: Base 1 Terminal ($12.00) + Extra Terminals @ $12.00 (includes 3 stores/terminal) -->
        <record id="subscription_plan_custom" model="havanoposdesk.subscription.plan">
            <field name="name">Custom Plan ($12/terminal)</field>
            <field name="price">12.00</field>
            <field name="duration_days">30</field>
            <field name="max_stores">3</field>
            <field name="max_terminals">1</field>
            <field name="max_users">15</field>
            <field name="is_custom">True</field>
            <field name="extra_terminal_price">12.00</field>
            <field name="stores_per_terminal">3</field>
        </record>
    </data>
</odoo>
