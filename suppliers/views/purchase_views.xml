<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Form View -->
        <record id="view_havanoposdesk_purchase_form" model="ir.ui.view">
            <field name="name">havanoposdesk.purchase.form</field>
            <field name="model">havanoposdesk.purchase</field>
            <field name="arch" type="xml">
                <form string="Purchase">
                    <header>
                        <button name="action_post" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state != 'posted'"/>
                        <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                        <button name="%(action_havanoposdesk_purchase_return_wizard)d" string="Debit Note" type="action" class="btn-primary" invisible="state != 'posted' or is_return"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                    </header>
                    <sheet>
                        <div class="oe_title" invisible="not id">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                            <h2>
                                <span invisible="not is_return" class="text-danger">Debit Note</span>
                            </h2>
                            <h3>
                                <field name="external_ref" readonly="1" invisible="not external_ref"/>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="has_variants" invisible="1"/>
                                <field name="supplier" readonly="state != 'draft'" class="border-bottom border-dark"/>
                                <field name="supplier_balance" string="Supplier Balance" widget="monetary" options="{'currency_field': 'tenant_currency_id'}" invisible="not supplier" class="text-muted"/>
                                <field name="available_currency_ids" invisible="1" />
                                <field name="allow_multi_currency" invisible="1"/>
                                <field name="currency_id" invisible="allow_multi_currency == False" domain="[('id', 'in', available_currency_ids)]" options="{'no_create': True}" class="border-bottom border-dark"/>
                                <field name="exchange_rate" invisible="allow_multi_currency == False" readonly="state != 'draft'" class="border-bottom border-dark" />
                                <field name="is_tax_enabled" invisible="1"/>
                                <field name="invoice_type" readonly="1" class="border-bottom border-dark" invisible="1"/>
                                <field name="tenant_currency_id" invisible="1"/>
                                <field name="supplier_allow_multi_currency" invisible="1"/>
                                <field name="supplier_secondary_currency_id" invisible="1"/>
                                <field name="supplier_secondary_balance" string="Secondary Balance" widget="monetary" options="{'currency_field': 'supplier_secondary_currency_id'}" invisible="not supplier_allow_multi_currency" class="text-muted"/>
                                <field name="is_return" invisible="1"/>
                                <field name="return_id" invisible="not is_return" readonly="1" class="border-bottom border-dark"/>
                            </group>
                            <group>
                                <field name="posting_date" readonly="state != 'draft'" class="border-bottom border-dark"/>
                                <field name="payment_status" readonly="state != 'draft'" class="border-bottom border-dark" widget="radio" options="{'horizontal': true}"/>
                                <field name="account_id" domain="[('tenant_id', '=', tenant_id), ('type', 'in', ['Cash', 'Bank']), ('active', '=', True), ('is_on_account', '=', False)]" invisible="payment_status != 'cash'" required="payment_status == 'cash'" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}" class="border-bottom border-dark"/>
                                <field name="store_id" options="{'no_create': True}" required="1" readonly="state != 'draft'" class="border-bottom border-dark"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Order Lines">
                                <field name="line_ids" readonly="state != 'draft'" mode="list,kanban">
                                    <list editable="bottom">
                                        <control>
                                            <create string="Add a product"/>
                                        </control>
                                        <field name="sequence" column_invisible="True"/>
                                        <field name="display_type" column_invisible="True"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="product_id" domain="[('store_ids', 'in', parent.store_id), ('track_qty', '=', True), ('is_bundle', '=', False), ('is_active', '=', True)]" width="40%" string="Item" placeholder="Select Item..." required="not display_type"/>
                                        <field name="variant_id" column_invisible="not parent.has_variants" domain="[('product_id', '=', product_id)]" options="{'no_create': True}" width="15%"/>
                                        <field name="available_uom_ids" column_invisible="True" />
                                        <field name="uom_id" domain="[('id', 'in', available_uom_ids)]" readonly="not available_uom_ids" options="{'no_create': True}" width="15%" string="UOM"/>
                                        <field name="accepted_qty" width="15%"/>
                                        <field name="rate" string="Cost Price" width="15%" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="amount" string="Total" width="15%" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="name" string="Description" optional="hide" placeholder="Description..." width="20%"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="purchase_total">
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" string="Total Excl" invisible="not is_tax_enabled"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" string="Total Tax" invisible="not is_tax_enabled"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}" string="Total Incl"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Purchase Tree View -->
        <record id="view_havanoposdesk_purchase_tree" model="ir.ui.view">
            <field name="name">havanoposdesk.purchase.tree</field>
            <field name="model">havanoposdesk.purchase</field>
            <field name="arch" type="xml">
                <list  string="Purchases">
                    <field name="currency_id" column_invisible="True"/>
                    <field name="tenant_currency_id" column_invisible="True" />
                    <field name="posting_date" string="Datetime" optional="show"/>
                    <field name="name" string="Reference" optional="show"/>
                    <field name="external_ref" string="External Ref" optional="show"/>
                    <field name="supplier" optional="show"/>
                    <field name="store_id" optional="show"/>
                    <field name="payment_status" optional="show"/>
                    <field name="amount_total" string="Total" widget="monetary" optional="show"/>
                    <field name="amount_total_base" string="Base Total" sum="Base Total" widget="monetary" options="{'currency_field': 'tenant_currency_id'}" optional="show" />
                    <field name="account_id" optional="show"/>
                    <field name="amount_total" string="Total Incl" sum="Total Incl" widget="monetary"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-danger="state == 'cancelled'" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Purchase Search View -->
        <record id="view_havanoposdesk_purchase_search" model="ir.ui.view">
            <field name="name">havanoposdesk.purchase.search</field>
            <field name="model">havanoposdesk.purchase</field>
            <field name="arch" type="xml">
                <search string="Search Purchases">
                    <field name="name"/>
                    <field name="supplier"/>
                    <field name="create_uid"/>
                    <field name="posting_date"/>
                    <filter string="Today" name="today" domain="[('posting_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('posting_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Yesterday" name="yesterday" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-1)).strftime('%Y-%m-%d 00:00:00')), ('posting_date', '&lt;=', (context_today() + datetime.timedelta(days=-1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Last 2 Days" name="last_2_days" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-2)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Last 3 Days" name="last_3_days" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-3)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Last 4 Days" name="last_4_days" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-4)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Last 7 Days" name="last_7_days" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Last 10 Days" name="last_10_days" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-10)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Last 14 Days" name="last_14_days" domain="[('posting_date', '&gt;=', (context_today() + datetime.timedelta(days=-14)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="This Month" name="this_month" domain="[('posting_date', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]" />
                    <filter string="Supplier" name="filter_supplier" domain="[('supplier', '!=', False)]"/>
                    <filter string="Created By" name="filter_created_by" domain="[('create_uid', '!=', False)]"/>
                    <filter string="Created On" name="filter_created_on" date="posting_date"/>
                    <group>
                        <filter string="Tenant" name="group_by_tenant" context="{'group_by': 'tenant_id'}"/>
                        <filter string="Supplier" name="group_by_supplier" context="{'group_by': 'supplier'}"/>
                        <filter string="Created By" name="group_by_created_by" context="{'group_by': 'create_uid'}"/>
                        <filter string="Created On" name="group_by_created_on" context="{'group_by': 'posting_date:day'}"/>
                        <filter string="Currency" name="group_by_currency" context="{'group_by': 'currency_id'}" />
                        <filter string="Today" name="group_today" domain="[('posting_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]" context="{'group_by': 'posting_date:day'}"/>
                        <filter string="This Month" name="group_month" domain="[('posting_date', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]" context="{'group_by': 'posting_date:month'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_havanoposdesk_purchase_graph" model="ir.ui.view">
            <field name="name">havanoposdesk.purchase.graph</field>
            <field name="model">havanoposdesk.purchase</field>
            <field name="arch" type="xml">
                <graph string="Purchases Analysis" type="bar" sample="1">
                    <field name="posting_date" interval="day"/>
                    <field name="amount_total" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_havanoposdesk_purchase_pivot" model="ir.ui.view">
            <field name="name">havanoposdesk.purchase.pivot</field>
            <field name="model">havanoposdesk.purchase</field>
            <field name="arch" type="xml">
                <pivot string="Purchases Analysis" sample="1">
                    <field name="posting_date" interval="month" type="row"/>
                    <field name="supplier" type="col"/>
                    <field name="amount_total" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Action -->
        <record id="action_havanoposdesk_purchase" model="ir.actions.act_window">
            <field name="name">Purchases</field>
            <field name="res_model">havanoposdesk.purchase</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="search_view_id" ref="view_havanoposdesk_purchase_search"/>
            <field name="context">{'search_default_today': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Purchase Record
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_suppliers_purchase" 
                  name="Purchases" 
                  parent="menu_suppliers_operations" 
                  action="action_havanoposdesk_purchase" 
                  sequence="10"/>
    </data>
</odoo>


