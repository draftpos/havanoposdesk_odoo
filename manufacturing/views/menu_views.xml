<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_havanoposdesk_manufacturing_root" 
              name="Manufacturing" 
              sequence="50"/>

    <menuitem id="menu_havanoposdesk_manufacturing_bom" 
              name="Bills of Materials" 
              parent="menu_havanoposdesk_manufacturing_root" 
              action="action_havanoposdesk_manufacturing_bom" 
              sequence="10"/>

    <menuitem id="menu_havanoposdesk_manufacturing_orders" 
              name="Production Orders" 
              parent="menu_havanoposdesk_manufacturing_root" 
              action="action_havanoposdesk_production_order" 
              sequence="20"/>

    <record id="action_havanoposdesk_manufacturing_reports" model="ir.actions.act_window">
        <field name="name">Manufacturing Reports</field>
        <field name="res_model">havanoposdesk.stock.ledger</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('type', 'ilike', 'Production')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No manufacturing records found.
            </p>
        </field>
    </record>

    <menuitem id="menu_havanoposdesk_manufacturing_reports" 
              name="Reports" 
              parent="menu_havanoposdesk_manufacturing_root" 
              action="action_havanoposdesk_manufacturing_reports" 
              sequence="30"/>
</odoo>
